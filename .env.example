# Root Environment Template for Docker Compose
# Copy this file to .env before running docker-compose up

NODE_ENV=production
PORT=5000
JWT_SECRET=super_secret_jwt_key_change_in_production_12345!
JWT_EXPIRES_IN=7d

# Delivery Configuration
BASE_DELIVERY_FEE=30
PER_KM_DELIVERY_FEE=10
FREE_DELIVERY_THRESHOLD=500
TAX_RATE_PERCENTAGE=5
PLATFORM_FEE=5

# Ports
BACKEND_PORT=5000
FRONTEND_PORT=3000
MONGO_PORT=27017
